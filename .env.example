# --- Database / object storage (local dev; compose binds these ports to 127.0.0.1) ---
DATABASE_URL=postgresql://ajaia:ajaia@localhost:54329/ajaia
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=ajaia-attachments
S3_ACCESS_KEY=ajaia
S3_SECRET_KEY=ajaia-secret-key

# --- Auth: Auth.js v5 + Keycloak (OIDC) ---
# Public URL of the app. Keycloak uses it for the client's redirect/logout URIs.
APP_URL=http://localhost:3100
# Auth.js base URL (same as APP_URL) and trust of the X-Forwarded-* headers from Caddy.
AUTH_URL=http://localhost:3100
AUTH_TRUST_HOST=true
# Encrypts the session cookie. Generate: openssl rand -base64 32
AUTH_SECRET=dev-only-auth-secret-change-me-0123456789abcdef
AUTH_KEYCLOAK_ID=ajaia-docs
# Must equal KC_CLIENT_SECRET (the realm import creates the client with that secret).
AUTH_KEYCLOAK_SECRET=dev-client-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8180/realms/ajaia

# --- Keycloak container ---
KC_CLIENT_SECRET=dev-client-secret
# Keycloak admin console user is `admin`.
KC_ADMIN_PASSWORD=admin

# --- Production only (docker compose --profile prod) — uncomment and fill in ---
# DOMAIN=203-0-113-10.sslip.io
# APP_URL=https://203-0-113-10.sslip.io
# AUTH_URL=https://203-0-113-10.sslip.io
# KC_HOSTNAME=http://keycloak:8080      (Keycloak is internal-only in production)
# KC_COMMAND=start --import-realm
# POSTGRES_PASSWORD=<random>
# S3_SECRET_KEY=<random, >= 8 chars>
# AUTH_SECRET=<openssl rand -base64 32>
# KC_CLIENT_SECRET=<random>          (the app container reads it as AUTH_KEYCLOAK_SECRET)
# KC_ADMIN_PASSWORD=<random>
# (AUTH_KEYCLOAK_ISSUER for the app container is derived from KC_HOSTNAME in docker-compose.yml)
